rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 프로필: 누구나 읽기, 본인만 생성/수정 (닉네임 2~12자)
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12;
    }

    // 닉네임 중복 방지용 예약 문서
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 랭킹: 게임/모드별 보드, 유저당 최고점 1건. 누구나 읽기, 본인 문서만 "더 높은 점수로" 갱신
    match /leaderboards/{board}/entries/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(uid)).data.nickname;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.score is int
        && request.resource.data.score > resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(uid)).data.nickname;
    }
  }
}

// TODO(경쟁 모드 정식 오픈 시): 클라이언트가 점수를 직접 쓰면 조작이 가능합니다.
//   Cloud Functions(callable)에서 점수를 검증한 뒤 저장하도록 바꾸고, 위 create/update 규칙은 닫으세요.
